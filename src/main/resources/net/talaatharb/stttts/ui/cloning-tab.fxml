<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10"
      fx:controller="net.talaatharb.stttts.ui.VoiceCloningTabController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Engine:" styleClass="field-label"/>
        <Label fx:id="engineLabel" styleClass="engine-name"/>
        <Label fx:id="modelStatus" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Download model" onAction="#onInstall"/>
    </HBox>
    <Label fx:id="referenceHint" styleClass="muted" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Reference:" styleClass="field-label"/>
        <Button fx:id="recordButton" text="Record"/>
        <ProgressBar fx:id="levelMeter" prefWidth="120"/>
        <Button text="Open audio file..." onAction="#onOpenReference"/>
        <Button fx:id="sampleVoiceButton" text="Use sample voice" onAction="#onSampleVoice"/>
        <Button fx:id="playReferenceButton" text="Play reference" onAction="#onPlayReference"/>
        <Label fx:id="referenceInfo" styleClass="muted"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Exaggeration:" styleClass="field-label"/>
        <Slider fx:id="exaggerationSlider" min="0.25" max="2.0" value="0.5" majorTickUnit="0.25" prefWidth="200"/>
        <Label fx:id="exaggerationLabel"/>
    </HBox>
    <TextArea fx:id="textInput" wrapText="true" VBox.vgrow="ALWAYS"
              text="This is my cloned voice, generated locally on this computer."/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="cloneButton" text="Generate" defaultButton="true" onAction="#onClone"/>
        <Button fx:id="playButton" text="Play" onAction="#onPlay"/>
        <Button fx:id="saveButton" text="Save WAV..." onAction="#onSave"/>
        <Label fx:id="resultInfo" styleClass="muted"/>
    </HBox>
    <Label styleClass="muted" wrapText="true"
           text="Only clone voices you have permission to use."/>
</VBox>
